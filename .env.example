# AgentFi environment template. Never commit real credentials.

APP_ENV=testnet
APP_SECRET_KEY=replace-with-a-long-random-secret
TRADING_MODE=TESTNET
NETWORK=sepolia

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=agentfi

# Redis
REDIS_URL=redis://localhost:6379/0

# WhatsApp: twilio or meta; credentials are required.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# EVM / wallet providers
PRIVY_APP_ID=
PRIVY_APP_SECRET=
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
CDP_WALLET_SECRET=
EXISTING_WALLET_ADDRESS=
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Intelligence and agents
GRAPH_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Hedera
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_OPERATOR_ID=

# Arc / USDC
ARC_NETWORK=sepolia
ARC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARC_USDC_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Uniswap
UNISWAP_CHAIN_ID=11155111
UNISWAP_ROUTER_ADDRESS=
UNISWAP_QUOTER_ADDRESS=

# External integrations
CHAINLINK_CRE_CONFIG=
CHAINLINK_CRE_ORG_ID=
CHAINLINK_CRE_WALLET=
CHAINLINK_CRE_GATEWAY=
BAZANTIC_JWT=

API_BASE_URL=http://localhost:8000
WHATSAPP_SERVICE_URL=http://localhost:8001
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
PLATFORM_FEE_PERCENT=10
