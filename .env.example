# ============================================================
# AgentFi — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_ENV=development            # development | testnet | production
APP_SECRET_KEY=your-super-secret-key-change-this
TRADING_MODE=PAPER             # PAPER | TESTNET (never MAINNET for autonomous trading)
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://agentfi:agentfi_dev_password@localhost:5432/agentfi
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- WhatsApp Provider (Twilio vs Meta) ----
# Choose "twilio" (recommended for instant sandbox testing) or "meta" (Meta Cloud API) or "mock"
WHATSAPP_PROVIDER=twilio

# Option A: Twilio WhatsApp (Get from: https://console.twilio.com/ -> Messaging -> Try WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# Option B: Meta WhatsApp Cloud API (Get from: https://developers.facebook.com/apps/)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=agentfi_webhook_verify_token
WHATSAPP_API_VERSION=v18.0

# ---- Privy (Embedded Wallets) ----
# Get from: https://privy.io/
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_NETWORK=base-sepolia  # testnet

# ---- The Graph ----
# Get from: https://thegraph.com/
GRAPH_API_KEY=
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api
GRAPH_UNISWAP_V3_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV

# ---- Hedera (Agent-to-Agent Payments) ----
# Get testnet account: https://portal.hedera.com/
HEDERA_NETWORK=testnet         # testnet | mainnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_OPERATOR_ID=

# ---- Arc / USDC (Stablecoin Economy) ----
ARC_NETWORK=base-sepolia
ARC_RPC_URL=https://sepolia.base.org
ARC_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ---- ENS (Agent Identity) ----
ENS_RPC_URL=https://mainnet.infura.io/v3/your-infura-key
ENS_ROOT_DOMAIN=agentfi.eth

# ---- Chainlink CRE (Confidential Risk) ----
CHAINLINK_CRE_CONFIG=
CHAINLINK_CRE_DON_ID=

# ---- Ledger (Secure Signing) ----
LEDGER_CONFIG=

# ---- Uniswap ----
UNISWAP_API_KEY=
UNISWAP_ROUTER_ADDRESS=0x3fC91A3afd70395Cd496C647d5a6CC9D4B2b7FAD
UNISWAP_QUOTER_ADDRESS=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
UNISWAP_CHAIN_ID=84532  # Base Sepolia

# ---- AI / LLM ----
# Choose one provider:
LLM_PROVIDER=gemini            # gemini | openai | anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-2.0-flash    # or gpt-4o / claude-3-5-sonnet

# ---- Bazantic (MCP/x402 Services) ----
BAZANTIC_CONFIG=

# ---- CORS / API ----
API_BASE_URL=http://localhost:8000
WHATSAPP_SERVICE_URL=http://localhost:8001
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Platform Fees ----
PLATFORM_FEE_PERCENT=10        # 10% platform fee on subscriptions

# Coinbase Developer Platform (CDP) API Credentials
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

